---
// 首页开场 V2：两幕连续 Opening（仅首页渲染）
//   Stage 1  电影字幕式短句 → 停在 At Karina. → GO
//   Stage 2  超大橙色 KARINA / STUDIO 排版变换 → 橙色铺屏 → 揭开首页
// 是否播放由 sessionStorage 决定；首帧是否覆盖由 <head> 内联脚本加上 html.intro-on 控制。
// 只用 CSS + Web Animations API，无第三方动画库。
const GHOSTS = ['SEO', 'GEO', 'XEO', 'GOOGLE', 'ALGORITHM', 'CASE', 'SEARCH', 'CONTENT', 'KARINA'];

// 第一幕文案：每个词是一个 span，整句预排好，用遮罩从左往右扫过去（不是打字机、不改 DOM 文本）。
// [词, 是否斜体]；start/per/exit/pauseBefore/pause 是时间轴（毫秒）。
const LINES = [
  { words: [['SEO.'], ['GEO.'], ['XEO.'], ['In', true], ['Google.']], start: 300, per: 240, pauseBefore: 4, pause: 380, exit: 2300 },
  { words: [['Google'], ['Algorithms.']], start: 2300, per: 220, exit: 3050 },
  { words: [['Real'], ['Cases.']], start: 3050, per: 210, exit: 3750 },
  { words: [['All'], ['Things'], ['You'], ['Wanna'], ['Know.']], start: 3750, per: 300, exit: 5550 },
  { words: [['At'], ['Karina', true], ['Studio', true]], start: 5550, per: 240, last: true },
];
const LAST_STATIC = 'At Karina Studio';
---

<div id="home-intro" class="home-intro" role="dialog" aria-label="网站开场">
  <!-- 第一幕：字幕 -->
  <div class="intro-stage intro-stage-one" id="intro-stage-one">
    <div class="intro-ghosts" aria-hidden="true">
      {GHOSTS.map((word) => <span>{word}</span>)}
    </div>

    <div class="intro-center">
      <div class="intro-tagline" id="intro-tagline" aria-hidden="true">
        {LINES.map((line) => (
          <p
            class="intro-line"
            data-start={line.start}
            data-per={line.per}
            data-exit={line.exit ?? ''}
            data-pause-before={line.pauseBefore ?? ''}
            data-pause={line.pause ?? ''}
            data-static={line.last ? '1' : (line.start === 300 ? '1' : undefined)}
          >
            {line.words.map(([text, em]) => <span class:list={['w', em && 'em']}>{text}</span>)}
          </p>
        ))}
      </div>

      <button class="intro-enter" id="intro-enter" type="button" hidden>Lets Go →</button>

      <p class="visually-hidden">Karina Studio — SEO / GEO / XEO、Google 算法、真实案例</p>
    </div>
  </div>

  <!-- 第二幕：Karina Studio 大字排版 -->
  <div class="intro-stage intro-stage-two is-uppercase" id="intro-stage-two" hidden aria-hidden="true">
    <div class="karina-type" id="karina-type">
      <span class="karina-word" id="karina-word">Karina</span>
      <span class="studio-word" id="studio-word">Studio</span>
    </div>
    <div class="karina-wipe" id="karina-wipe"></div>
  </div>

  <button class="intro-skip" id="intro-skip" type="button">Skip</button>
</div>

<script>
  const KEY = 'homepage_intro_seen';


  const EASE_IN = 'cubic-bezier(.22, 1, .36, 1)';
  const EASE_OUT = 'cubic-bezier(.4, 0, 1, 1)';
  const ENTER_KF = [
    { opacity: 0, transform: 'translateY(22px) scale(.97)', filter: 'blur(6px)' },
    { opacity: 1, transform: 'translateY(0) scale(1)', filter: 'blur(0)' },
  ];
  const EXIT_KF = [
    { opacity: 1, transform: 'translateY(0) scale(1)', filter: 'blur(0)' },
    { opacity: 0, transform: 'translateY(-16px) scale(1.02)', filter: 'blur(4px)' },
  ];

  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
  const isSeen = () => { try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; } };
  const markSeen = () => { try { sessionStorage.setItem(KEY, '1'); } catch { /* 隐私模式忽略 */ } };

  let phase = 'idle';            // idle / stage1 / waiting-go / stage2 / revealing / done
  const running = new Set();

  const play = (el, kf, opts) => {
    const anim = el.animate(kf, opts);
    running.add(anim);
    anim.finished.catch(() => {}).finally(() => running.delete(anim));
    return anim;
  };

  const init = () => {
    const intro = document.getElementById('home-intro');
    const root = document.documentElement;
    const alive = () => document.body.contains(intro);

    if (!intro) {                                  // 内页：清掉可能残留的开场状态
      root.classList.remove('intro-on');
      running.forEach((a) => a.cancel());
      running.clear();
      phase = 'done';
      return;
    }
    if (phase === 'done' || intro.dataset.done === '1') return;
    if (isSeen()) {                                // 本 session 看过：直接收掉
      intro.hidden = true;
      root.classList.remove('intro-on');
      phase = 'done';
      return;
    }
    if (phase !== 'idle') return;                  // 已经在跑（astro:page-load 会再调一次）
    root.classList.add('intro-on');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stageOne = intro.querySelector('#intro-stage-one');
    const stageTwo = intro.querySelector('#intro-stage-two');
    const tagline = intro.querySelector('#intro-tagline');
    const go = intro.querySelector('#intro-enter');
    const skip = intro.querySelector('#intro-skip');
    const typeWrap = intro.querySelector('#karina-type');
    const karinaWord = intro.querySelector('#karina-word');
    const studioWord = intro.querySelector('#studio-word');
    const wipe = intro.querySelector('#karina-wipe');
    const homeEls = [document.querySelector('.layout'), document.querySelector('.footer')].filter(Boolean);

    const fadeInHome = (duration, delay) => homeEls.forEach((el) => play(el, [
      { opacity: 0, transform: 'translateY(8px)' },
      { opacity: 1, transform: 'translateY(0)' },
    ], { duration, delay, easing: EASE_IN, fill: 'forwards' }));

    const finish = () => {
      if (!alive() || phase === 'done') return;
      phase = 'done';
      markSeen();
      intro.dataset.done = '1';
      intro.hidden = true;
      root.classList.remove('intro-on');
      running.forEach((a) => a.cancel());
      running.clear();
    };

    // Skip 与"减少动效"走的短过渡：淡出开场层，不做橙色铺屏
    const shortReveal = async () => {
      if (!alive() || phase === 'done' || phase === 'revealing') return;
      phase = 'revealing';
      fadeInHome(240, 0);
      const fade = play(intro, [{ opacity: 1 }, { opacity: 0 }], { duration: 260, easing: EASE_OUT, fill: 'forwards' });
      await fade.finished.catch(() => {});
      finish();
    };

    // ── 第二幕：四个 Beat → 橙色铺屏 → 揭开首页 ──
    const stageTwoRun = async () => {
      if (!alive()) return;
      phase = 'stage2';
      intro.classList.add('is-stage-two');
      stageOne.hidden = true;
      stageTwo.hidden = false;

      // Beat A：巨大的 KARINA 从下方长出来
      karinaWord.style.opacity = '1';
      await play(karinaWord, [
        { transform: 'translateY(20%) scaleX(.75)', clipPath: 'inset(100% 0 0 0)' },
        { transform: 'translateY(0) scaleX(1)', clipPath: 'inset(0 0 0 0)' },
      ], { duration: 450, easing: EASE_IN, fill: 'forwards' }).finished.catch(() => {});
      if (!alive()) return;

      // Beat B：横向拉伸 + 压紧字距，STUDIO 从右下进入
      const beatB = play(karinaWord, [
        { transform: 'translateX(0) scaleX(1)', letterSpacing: '-0.04em' },
        { transform: 'translateX(-4vw) scaleX(1.2)', letterSpacing: '-0.08em' },
      ], { duration: 450, easing: EASE_IN, fill: 'forwards' });
      play(studioWord, [
        { transform: 'translate(30%, 40%) scale(.86)', opacity: 0, clipPath: 'inset(0 0 100% 0)' },
        { transform: 'translate(0, 0) scale(1)', opacity: 1, clipPath: 'inset(0 0 0 0)' },
      ], { duration: 480, delay: 220, easing: EASE_IN, fill: 'forwards' });
      await beatB.finished.catch(() => {});
      if (!alive()) return;

      // Beat C：STUDIO 接管画面，两词咬合但仍可读
      const beatC = play(typeWrap, [
        { transform: 'scale(1)', gap: '0.06em' },
        { transform: 'scale(1.03)', gap: '-0.12em' },
      ], { duration: 500, easing: EASE_IN, fill: 'forwards' });
      play(karinaWord, [
        { transform: 'translateX(-4vw) scaleX(1.2)' },
        { transform: 'translateX(0) scaleX(.94)' },
      ], { duration: 500, easing: EASE_IN, fill: 'forwards' });
      await beatC.finished.catch(() => {});
      if (!alive()) return;

      // Beat D：收束成正常的 Karina Studio（大小写与字距归位）
      stageTwo.classList.remove('is-uppercase');
      await play(typeWrap, [
        { transform: 'scale(1.03)', letterSpacing: '-0.02em' },
        { transform: 'scale(1)', letterSpacing: '-0.03em' },
      ], { duration: 450, easing: EASE_IN, fill: 'forwards' }).finished.catch(() => {});
      if (!alive()) return;

      await sleep(260);                            // 停一下，让人真的读到品牌名
      if (!alive()) return;

      // 橙色铺屏：字形继续放大，橙色层同时从字后扩张
      phase = 'revealing';
      await Promise.all([
        play(karinaWord, [
          { transform: 'scale(1)', opacity: 1 },
          { transform: 'scale(14)', opacity: 1 },
        ], { duration: 400, easing: EASE_IN, fill: 'forwards' }).finished,
        play(wipe, [
          { transform: 'scale(.05)', opacity: 0 },
          { transform: 'scale(1)', opacity: 1 },
        ], { duration: 400, easing: EASE_IN, fill: 'forwards' }).finished,
      ]).catch(() => {});
      if (!alive()) return;

      // 整屏已是橙色：覆盖层自身背景转透明，橙色层向上揭开，露出首页
      intro.classList.add('is-wipe');
      typeWrap.style.opacity = '0';
      fadeInHome(560, 60);
      await play(wipe, [
        { clipPath: 'inset(0 0 0 0)' },
        { clipPath: 'inset(0 0 100% 0)' },
      ], { duration: 560, easing: EASE_IN, fill: 'forwards' }).finished.catch(() => {});
      finish();
    };

    // 减少动效：静态两行 + GO；点击后静态品牌名短暂停留，再淡出
    const reducedRun = () => {
      phase = 'stage1';
      tagline.classList.add('is-static');
      tagline.style.opacity = '1';
      go.hidden = false;
      go.dataset.on = '1';
      phase = 'waiting-go';
      go.addEventListener('click', async () => {
        if (phase !== 'waiting-go') return;
        phase = 'stage2';
        stageOne.hidden = true;
        stageTwo.hidden = false;
        stageTwo.classList.remove('is-uppercase');
        karinaWord.style.opacity = '1';
        studioWord.style.opacity = '1';
        await sleep(220);
        shortReveal();
      });
    };

    // 第一幕：整句预排好，遮罩从左往右扫过；每个词到达前留一小段"坡"，
    // 观感是一个词一个词出现，但 DOM 完全不改（无重排、无打字机）。
    const stageOneRun = async () => {
      phase = 'stage1';
      const lines = [...tagline.querySelectorAll('.intro-line')];
      let end = 0;

      lines.forEach((el) => {
        const words = [...el.querySelectorAll('.w')];
        const start = Number(el.dataset.start) || 0;
        const per = Number(el.dataset.per) || 240;
        const exit = el.dataset.exit ? Number(el.dataset.exit) : null;
        const pauseBefore = el.dataset.pauseBefore ? Number(el.dataset.pauseBefore) : 0;
        const pause = Number(el.dataset.pause) || 0;
        const n = words.length;

        // 每个词揭示完成的时间点
        const marks = [];
        let t = 0;
        for (let i = 1; i <= n; i++) {
          if (pauseBefore && i === pauseBefore) t += pause;
          t += per;
          marks.push(t);
        }
        const total = exit !== null ? exit - start : marks[marks.length - 1] + 500;
        end = Math.max(end, start + total);

        const box = el.getBoundingClientRect();
        const stops = words.map((w) => {
          const wr = w.getBoundingClientRect();
          return Math.max(0, Math.min(100, ((box.right - wr.right) / box.width) * 100));
        });

        const clip = (r) => `inset(-0.4em ${r}% -0.4em 0)`;
        const kf = [{ clipPath: clip(100), offset: 0 }];
        let prev = 100;
        for (let i = 0; i < n; i++) {
          const at = marks[i] / total;
          const ramp = Math.max(0, at - 46 / total);            // 46ms 扫过，然后停住
          kf.push({ clipPath: clip(prev), offset: ramp });
          kf.push({ clipPath: clip(stops[i]), offset: at });
          prev = stops[i];
        }
        if (exit !== null) {
          kf.push({ clipPath: clip(0), offset: (total - 190) / total });
          kf.push({ clipPath: 'inset(-0.4em 0 0 100%)', offset: 1 });   // 整句向左划走
        } else {
          kf.push({ clipPath: clip(0), offset: 1 });                    // 末句停住（显式终帧）
        }
        play(el, kf, { duration: total, delay: start, fill: 'both' });
      });

      await sleep(end + 120);
      if (!alive()) return;
      phase = 'waiting-go';
      go.hidden = false;
      requestAnimationFrame(() => { go.dataset.on = '1'; });
    };

    // GO 不再进入首页，而是触发第二幕
    go.addEventListener('click', () => {
      if (reduced) return;                 // 减少动效由 reducedRun 的短路径处理，不走两幕动画
      if (phase !== 'waiting-go') return;
      go.disabled = true;
      go.dataset.on = '0';
      stageTwoRun();
    });

    // Skip：任何一幕都能立即结束 Opening，但仍走一个短过渡
    skip.addEventListener('click', () => shortReveal());

    intro.dataset.started = '1';                   // 告诉兜底脚本"序列活着"
    if (reduced) reducedRun();
    else stageOneRun();
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
