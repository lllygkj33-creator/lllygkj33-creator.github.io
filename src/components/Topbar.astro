---
const { nav, activeSection } = Astro.props;
---

<header class="topbar">
  <div class="topbar-in">
    <div class="topbar-row">
      <a class="brand" href="/">
        <img class="brand-logo" src="/logo.webp" alt="" width="86" height="34" />
        <span>Seo Geo Docs</span>
      </a>

      <label class="search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="nav-search" type="search" placeholder="Search..." autocomplete="off" aria-label="Search" />
        <span>⌘K</span>
      </label>

      <div class="topbar-right">
        <a href="https://github.com/">GitHub</a>

        <div class="theme">
          <button class="theme-btn" id="theme-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="切换深浅色">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <rect x="2.5" y="4" width="19" height="13" rx="2"></rect>
              <path d="M12 17v3.5M8.5 20.5h7"></path>
            </svg>
          </button>
          <div class="theme-menu" id="theme-menu" role="menu" hidden>
            <button type="button" role="menuitem" data-theme-value="light">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4.2"></circle>
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
              </svg>
              <span>浅色</span>
            </button>
            <button type="button" role="menuitem" data-theme-value="dark">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
              </svg>
              <span>深色</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <nav class="tabs" aria-label="Sections">
      {
        nav.map((s) => (
          <a href={s.url} class={s.id === activeSection ? 'active' : undefined}>{s.label}</a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const input = document.getElementById('nav-search');
  if (input) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      document.querySelectorAll('.side-group').forEach((g) => {
        let hit = 0;
        g.querySelectorAll('a').forEach((a) => {
          const show = !q || a.textContent.toLowerCase().includes(q);
          a.hidden = !show;
          if (show) hit++;
        });
        g.hidden = q ? hit === 0 : false;
      });
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        input.focus();
      }
    });
  }

  // 深浅色切换：小电脑按钮 -> 太阳 / 月亮
  const themeBtn = document.getElementById('theme-btn');
  const themeMenu = document.getElementById('theme-menu');
  if (themeBtn && themeMenu) {
    const close = () => {
      themeMenu.hidden = true;
      themeBtn.setAttribute('aria-expanded', 'false');
    };
    themeBtn.addEventListener('click', () => {
      const open = themeMenu.hidden;
      themeMenu.hidden = !open;
      themeBtn.setAttribute('aria-expanded', String(open));
    });
    themeMenu.addEventListener('click', (e) => {
      const item = e.target.closest('[data-theme-value]');
      if (!item) return;
      document.documentElement.dataset.theme = item.dataset.themeValue;
      localStorage.setItem('theme', item.dataset.themeValue);
      close();
    });
    addEventListener('click', (e) => {
      if (!e.target.closest('.theme')) close();
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
