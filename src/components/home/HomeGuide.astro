---
// 首页：9 屏沉浸式引导页（无顶栏、无页脚）
// 滚动模型 = 固定视窗中的短行程滚动驱动差速视差（pinned scroll-scrub，本地实现，无 GSAP）：
//   容器 120svh / 舞台 sticky 100svh / 真实滚动行程约 20svh
//   滚动 20svh 时：巨型标题上移 23vh，二级目录卡片组从下方 60vh 升到 0
//   追随延迟 ≈ scrub 0.85（每帧 lerp 逼近，不是硬跟滚轮）
//   卡片完全进入后：按鼠标横向位置平滑拖动整条轨道；悬停卡片放大
import { getNav } from '../../lib/nav';

const nav = await getNav();

// video : 该屏的背景视频（放 public/media/home/，留空则用纯色）
// scrim : 压在视频上的同色系叠色罩，让视频吃进这一屏的颜色并保证文字可读
const PALETTE = [
  { bg: '#2b0705', video: '/media/home/seo.mp4' },
  { bg: '#efe3cf', video: '/media/home/geo.mp4' },
  { bg: '#0e6f6b', video: '/media/home/social.mp4' },
  { bg: '#14161a', video: '/media/home/google-algorithm.mp4' },
  { bg: '#a8452b', video: '/media/home/content-quality.mp4' },
  { bg: '#2f3d24', video: '/media/home/skyscraper.mp4' },
  { bg: '#26364f', video: '/media/home/link-graph.mp4' },
  { bg: '#3b1d33', video: '/media/home/brand-entity-audit.mp4' },
  { bg: '#ff4813', video: '/media/home/link-automation.mp4' },
];

// 判断底色深浅：浅色底上白字读不出来，自动压一层暗罩
const luminance = (hex) => {
  const n = hex.replace('#', '');
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(n.slice(i, i + 2), 16) / 255);
  const f = (x) => (x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4));
  return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
};

// 首页 9 屏全英文（文档页仍用 nav.ts 里的中文，不动）
const SECTION_EN = {
  seo: 'SEO',
  geo: 'GEO',
  social: 'Social',
  'google-algorithm': 'Google Algorithms',
  'content-quality': 'Content Quality',
  skyscraper: 'Skyscraper',
  'link-graph': 'Link Graph',
  'brand-entity-audit': 'Brand Entity Audit',
  'link-automation': 'Link Automation',
};

const GROUP_EN = {
  基础: 'Basics',
  内容: 'Content',
  页面: 'On-page',
  技术: 'Technical',
  链接: 'Links',
  分析: 'Analytics',
  概念: 'Concepts',
  答案: 'Answers',
  实体: 'Entities',
  机器: 'Machine',
  测量: 'Measurement',
  平台: 'Platform',
  用户与社区: 'Community',
  社交与内容: 'Social & Content',
  视觉与发现: 'Visual & Discovery',
  技术与创客: 'Technical & Makers',
  趋势与需求: 'Trends & Demand',
  概览: 'Overview',
  规范: 'Spec',
  实例: 'Examples',
  示例: 'Examples',
  维度: 'Dimensions',
  质量: 'Quality',
  语义: 'Semantics',
  信号: 'Signals',
};

// 中文标题的页面用它自己的 slug 生成英文名（首页不出现中文）
const slugLabel = (url) => {
  const last = url.replace(/\/$/, '').split('/').pop() || '';
  return last
    .split('-')
    .map((w) => (w.length <= 3 && /^(on|of|and|the|for|in)$/.test(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)))
    .join(' ');
};

const panels = nav.slice(0, PALETTE.length).map((section, i) => {
  const entries = [];
  for (const group of section.groups) {
    const first = group.pages[0];
    if (group.label && first) {
      entries.push({ label: GROUP_EN[group.label] || slugLabel(first.url), meta: `${group.pages.length} pages`, url: first.url });
    }
  }
  // 分组少的栏目：用该栏页面的 slug 生成英文条目，保证每屏有 4–5 条、且不出现中文
  if (entries.length < 4) {
    for (const page of section.pages) {
      if (entries.length >= 5) break;
      if (!entries.some((e) => e.url === page.url)) entries.push({ label: slugLabel(page.url), meta: '', url: page.url });
    }
  }
  // 白字方案：底色越浅，压暗越重（深色底给一点点，避免纯黑更沉）
  const lum = luminance(PALETTE[i].bg);
  const base = lum > 0.55 ? 0.52 : lum > 0.3 ? 0.34 : lum > 0.12 ? 0.26 : 0.2;
  const dim = Math.max(base, PALETTE[i].video ? 0.34 : 0);   // 视频屏再兜一层，保证白字
  const textScrim = `linear-gradient(180deg, rgba(0,0,0,${(dim * 0.72).toFixed(2)}) 0%, rgba(0,0,0,${(dim * 0.4).toFixed(2)}) 42%, rgba(0,0,0,${(dim * 1.05).toFixed(2)}) 100%)`;

  return {
    section,
    color: PALETTE[i],
    entries,
    no: String(i + 1).padStart(2, '0'),
    titleEn: SECTION_EN[section.id] || section.label,
    textScrim,
  };
});

const total = panels.length;
---

<div class="guide" id="guide">
  {
    panels.map(({ section, color, entries, no, titleEn, textScrim }) => (
      <section
        class="gpanel"
        style={`--bg:${color.bg}; --ink:${color.ink}; --accent:${color.accent};${color.scrim ? ` --scrim:${color.scrim};` : ''}`}
        data-panel={no}
        data-video={color.video ? '1' : undefined}
      >
        <div class="gpanel-stage">
          {textScrim && <span class="gpanel-textscrim" style={`background:${textScrim}`} aria-hidden="true" />}
          {color.video && (
            <>
              <video class="gpanel-video" src={color.video} muted playsinline loop preload="metadata" aria-hidden="true" />
              <span class="gpanel-scrim" aria-hidden="true" />
            </>
          )}

          <div class="gpanel-head" data-head>
            <span class="gpanel-no">{no}</span>
            <h2 class="gpanel-title">{titleEn}</h2>
          </div>

          <div class="gpanel-rail" data-rail>
            {entries.map((e) => (
              <a class="gline" href={e.url}>
                <span class="gline-label">{e.label}</span>
                <span class="gline-arrow" aria-hidden="true">→</span>
              </a>
            ))}

            <a class="gline gline-enter" href={section.url}>
              <span class="gline-label">Enter {titleEn}</span>
              <span class="gline-arrow" aria-hidden="true">→</span>
            </a>
          </div>

          <span class="gpanel-count" aria-hidden="true">{no} / {String(total).padStart(2, '0')}</span>
          {no === '01' && <span class="gpanel-hint" aria-hidden="true">Scroll ↓</span>}
        </div>
      </section>
    ))
  }
</div>

<style>
  .guide { background: var(--bg); }

  /* 容器 120svh，舞台 100svh sticky：真实滚动行程 = 20svh */
  .gpanel {
    position: relative;
    height: 120vh;
    height: 120svh;
    background: var(--bg);
    color: var(--ink);
  }
  .gpanel-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }

  .gpanel-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .gpanel-video.is-ready { opacity: 1; }
  .gpanel-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--scrim, transparent);
    pointer-events: none;
  }

  /* 巨型标题层：滚动 20svh 期间上移 23vh */
  .gpanel-head {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding: 0 3rem;
    will-change: transform;
  }
  .gpanel-textscrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .gpanel-no {
    font-style: italic;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    color: #fff;
    opacity: 0.72;
    align-self: center;
  }
  /* 全英文 + 统一斜体（Fraunces 真斜体） */
  .gpanel-title {
    margin: 0;
    color: #fff;
    font-family: var(--display);
    font-style: italic;
    font-synthesis: none;
    font-weight: 400;
    font-size: clamp(2.4rem, 9vw, 8rem);
    letter-spacing: -0.02em;
    line-height: 0.95;
  }

  /* 二级目录卡片轨道：从下方 60vh 升到 0 */
  .gpanel-rail {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    width: max-content;
    padding: 0 3rem 5vh;
    will-change: transform;
  }

  /* 一条横线 + 白色斜体字（中文也走斜体，浏览器会对中日韩字形做倾斜） */
  .gline {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 10rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.42);
    color: #fff;
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0.01em;
    transition: border-color 320ms ease;
  }
  .gline:hover,
  .gline:focus-visible { border-color: rgba(255, 255, 255, 0.95); }
  .gline-label { white-space: nowrap; }
  .gline-arrow {
    font-size: 0.8125rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .gline:hover .gline-arrow,
  .gline:focus-visible .gline-arrow { opacity: 1; transform: none; }
  .gline-enter { min-width: auto; }

  .gpanel-count {
    position: absolute;
    right: 3rem;
    top: 2.5rem;
    z-index: 3;
    color: #fff;
    font-style: italic;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    opacity: 0.55;
  }
  .gpanel-hint {
    position: absolute;
    left: 3rem;
    bottom: 2.5rem;
    z-index: 3;
    color: #fff;
    font-style: italic;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .gpanel-head { padding: 0 1.5rem; }
    .gpanel-rail { flex-wrap: wrap; width: 100%; gap: 1.1rem 1.6rem; padding: 0 1.5rem 4vh; }
    .gline { min-width: 7rem; font-size: 0.9375rem; }
    .gpanel-count { right: 1.5rem; }
    .gpanel-hint { left: 1.5rem; }
  }

  /* 减少动效：不留 sticky 行程，直接静态呈现 */
  @media (prefers-reduced-motion: reduce) {
    .gpanel { height: 100vh; height: 100svh; }
    .gpanel-stage { position: relative; }
    .gpanel-head, .gpanel-rail { transform: none !important; }
    .gpanel-rail { position: static; padding: 0 1.5rem 4vh; }
  }
</style>

<script>
  const init = () => {
    const guide = document.getElementById('guide');
    if (!guide) { document.documentElement.classList.remove('guide-home'); return; }
    document.documentElement.classList.add('guide-home');   // 首页隐藏右侧滚动条

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const panels = [...guide.querySelectorAll('.gpanel')];

    // 背景视频：进入这一屏才播放，离开暂停
    const vio = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const video = e.target.querySelector('.gpanel-video');
        if (!video) return;
        if (e.isIntersecting) {
          video.classList.add('is-ready');
          const p = video.play();
          if (p && typeof p.catch === 'function') p.catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.15 });
    panels.forEach((p) => { if (p.dataset.video === '1') vio.observe(p); });

    if (reduced) return;

    // 每一屏一个状态：滚动进度 → 标题 -23vh、轨道 60vh→0，带 scrub 追随延迟
    const states = panels.map((panel) => {
      return {
        panel,
        head: panel.querySelector('[data-head]'),
        rail: panel.querySelector('[data-rail]'),
        target: 0,
        eased: 0,
        railX: 0,
        railXTarget: 0,
      };
    });

    const SMOOTH = 0.14;     // 每帧逼近比例：≈ 原站 scrub 0.85 的追随感
    const RAIL_SMOOTH = 0.1; // 横向拖动约 0.5s 追上鼠标

    const measure = () => {
      const vh = window.innerHeight;
      for (const s of states) {
        const r = s.panel.getBoundingClientRect();
        const range = r.height - vh;                       // 120svh - 100svh ≈ 20svh
        s.target = range > 0 ? Math.min(1, Math.max(0, -r.top / range)) : (r.top <= 0 ? 1 : 0);
        // 轨道完全进入 (进度 > 0.85) 之后才允许横向拖动
        const stage = s.panel.querySelector('.gpanel-stage');
        const rail = s.rail;
        const maxMove = Math.max(0, rail.scrollWidth - stage.clientWidth);
        s.maxMove = maxMove;
      }
    };

    // 横向拖动只在鼠标真的移动过之后才生效：否则轨道会自己滑到中间
    let pointerRatio = 0;
    let pointerSeen = false;
    if (finePointer) {
      guide.addEventListener('pointermove', (event) => {
        const rect = event.currentTarget.getBoundingClientRect();
        pointerRatio = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
        pointerSeen = true;
      });
    }

    const render = () => {
      for (const s of states) {
        s.eased += (s.target - s.eased) * SMOOTH;
        if (Math.abs(s.target - s.eased) < 0.0005) s.eased = s.target;

        const headY = -23 * s.eased;                      // 标题上移 23vh
        const railY = 60 * (1 - s.eased);                 // 轨道 60vh → 0
        s.head.style.transform = `translate3d(0, ${headY.toFixed(2)}vh, 0)`;

        // 轨道完全进入（进度 > 0.85）且鼠标移动过之后，才按鼠标横向位置拖动
        const ready = s.eased > 0.85 && (s.maxMove || 0) > 8 && pointerSeen;
        s.railXTarget = ready ? -s.maxMove * pointerRatio : 0;
        s.railX += (s.railXTarget - s.railX) * RAIL_SMOOTH;
        s.rail.style.transform = `translate3d(${s.railX.toFixed(1)}px, ${railY.toFixed(2)}vh, 0)`;
      }
      requestAnimationFrame(render);
    };

    // ?debug=1 时把内部状态挂到 window，便于定位问题
    if (new URLSearchParams(location.search).get('debug') === '1') {
      window.__guide = { states, measure };
    }

    window.addEventListener('scroll', measure, { passive: true });
    window.addEventListener('resize', measure);
    measure();
    requestAnimationFrame(render);

    // ?goto=bottom 直接平滑滑到最后一屏（方便给别人看最终状态）
    const goto = new URLSearchParams(location.search).get('goto');
    if (goto === 'bottom') window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    else if (/^[1-9]$/.test(goto || '')) {
      const target = panels[Number(goto) - 1];
      if (target) window.scrollTo({ top: target.offsetTop + target.offsetHeight * 0.5, behavior: 'smooth' });
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
