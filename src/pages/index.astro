---
// 首页：Karina Studio Hero（Intro 的最终帧就是这一页的首屏）
// Overlay 盖在上面播放两段动画，播完只做淡出——用户感觉不到"动画结束"。
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import IntroOverlay from '../components/home/IntroOverlay.astro';
import HeroWordmark from '../components/home/HeroWordmark.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getNav } from '../lib/nav';

const nav = await getNav();
const title = 'Karina Studio — SEO / GEO / XEO';
const description = 'Karina Studio：SEO、GEO、XEO、Google 算法与内容系统的知识库。';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.webp" />
    <script is:inline>
      // 首帧之前决定是否盖 Overlay：桌面（≥1024）+ 本 session 未看过 + 未要求减少动效。
      // Hero 本身照常渲染在下面，Overlay 只是覆盖，所以移除时视觉不跳。
      try {
        var seen = false;
        try { seen = sessionStorage.getItem('homepage_intro_seen') === '1'; } catch (e) {}
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!seen && !reduced && window.innerWidth >= 1024) {
          document.documentElement.classList.add('intro-on');
        }
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body class="kn-home">
    <IntroOverlay />
    <HeroWordmark />
    <SiteFooter nav={nav} />
  </body>
</html>
